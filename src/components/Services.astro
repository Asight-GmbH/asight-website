---
import { getEntry } from 'astro:content';

interface Props { locale?: string; }
const { locale = 'de' } = Astro.props;

const services = await getEntry('pages', `${locale}/services`);
const { headline, subline, steps: stepsData } = services?.data ?? {};

const icons = [
  `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>`,
  `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v14a9 3 0 0 0 18 0V5"/><path d="M3 12a9 3 0 0 0 18 0"/></svg>`,
  `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/></svg>`,
];

const steps = (stepsData ?? []).map((step: any, i: number) => ({
  ...step,
  icon: icons[i],
}));
---

<section id="services" class="services-section">
  <div class="container">
    <div class="services-header">
      <h2 class="services-headline" set:html={headline} />
      <p class="services-subline">{subline}</p>
    </div>

    <div class="chain-wrapper">
      <div class="chain-numbers">
        {steps.map((step, i) => (
          <div class="number-bubble">
            <span>{step.number}</span>
            {i < steps.length - 1 && <div class="connector"></div>}
          </div>
        ))}
      </div>

      <div class="chain-steps">
        {steps.map((step) => (
          <div class="step-card">
            <div class="step-header">
              <div class="step-icon" set:html={step.icon} />
              <h3 class="step-title">{step.title}</h3>
            </div>
            <p class="step-subtitle">{step.subtitle}</p>
            <ul class="step-points">
              {step.points.map((point) => (
                <li><span class="point-dash">—</span> {point}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

<style>
  .services-section {
    background: #f6f7f8;
    padding: 5rem 0;
  }

  .services-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .services-headline {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 800;
    color: #1b222c;
    letter-spacing: -0.02em;
    line-height: 1.3;
    margin-bottom: 1rem;
  }

  .services-headline .highlight {
    color: #3AA6B9;
  }

  .services-subline {
    font-size: 1rem;
    color: #4B5F78;
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .chain-wrapper {
    position: relative;
  }

  .chain-numbers {
    display: flex;
    justify-content: space-around;
    margin-bottom: 0.5rem;
    padding: 0 4rem;
  }

  .number-bubble {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .number-bubble span {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    font-weight: 700;
    background: #fff;
    border: 1px solid rgba(27,34,44,0.10);
    color: #3AA6B9;
    position: relative;
    z-index: 2;
  }

  .connector {
    position: absolute;
    left: calc(50% + 24px);
    top: 50%;
    width: calc(100% + 8rem);
    height: 1px;
    background: rgba(27,34,44,0.10);
    z-index: 1;
  }

  .chain-steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .step-card {
    position: relative;
    background: #fff;
    border: 1px solid rgba(27,34,44,0.08);
    border-radius: 16px;
    padding: 1.75rem;
    transition: all 0.3s ease;
  }

  .step-card:hover {
    border-color: rgba(58,166,185,0.35);
  }

  .step-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .step-icon {
    width: 56px;
    height: 56px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background: rgba(58,166,185,0.1);
    color: #3AA6B9;
  }

  .step-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: #1b222c;
    margin: 0;
  }

  .step-subtitle {
    font-size: 0.9rem;
    color: #4B5F78;
    margin-bottom: 1rem;
    line-height: 1.6;
  }

  .step-points {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .step-points li {
    font-size: 0.85rem;
    color: #4B5F78;
    line-height: 1.6;
    margin-bottom: 0.4rem;
    display: flex;
    gap: 0.5rem;
  }

  .point-dash {
    flex-shrink: 0;
    color: #3AA6B9;
  }

  @media (max-width: 900px) {
    .chain-numbers {
      display: none;
    }

    .chain-steps {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }

  @media (max-width: 640px) {
    .services-section {
      padding: 3rem 0;
    }

    .services-header {
      margin-bottom: 2rem;
    }

    .step-card {
      padding: 1.25rem;
    }
  }
</style>
