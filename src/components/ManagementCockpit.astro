---
/**
 * Hero visual: a TrakState board inside an ASIGHT glass frame (PRODLOG-291).
 *
 * The frame (3D tilt, glass edge, shadow) is ASIGHT's; everything on the
 * screen follows the TrakState board as shown on trakstate.com under
 * "Ausprobieren" — square tiles with a status edge, mono figures, a bar chart
 * with a dashed target and an event list. Whoever clicks through finds the
 * same board again over there. All values are sample data and labelled so.
 */
import TrakStateWordmark from "./TrakStateWordmark.astro";

interface Props {
  locale?: string;
  /** CTA strip at the bottom; from src/content/pages/<locale>/trakstate.json. */
  trakstate?: { url: string; strip_text: string; strip_cta: string };
}
const { locale = 'de', trakstate } = Astro.props;
const en = locale === 'en';

type Tone = 'ok' | 'warn' | 'bad';

// UI labels of the mock-up. Marketing copy lives in Keystatic.
const L = en
  ? {
      eyebrow: 'This is TrakState · sample data',
      board: 'Management cockpit',
      site: 'Stuttgart plant',
      state: 'Running',
      asOf: 'As of',
      chart: 'OEE · last 12 weeks',
      target: 'Target 80 %',
      events: 'Events',
      week: 'CW',
    }
  : {
      eyebrow: 'So sieht TrakState aus · Musterdaten',
      board: 'Management-Cockpit',
      site: 'Werk Stuttgart',
      state: 'Läuft',
      asOf: 'Stand',
      chart: 'OEE · letzte 12 Wochen',
      target: 'Ziel 80 %',
      events: 'Ereignisse',
      week: 'KW',
    };

const num = (n: number, digits = 1) => (en ? n.toFixed(digits) : n.toFixed(digits).replace('.', ','));

// `tick` lets the script drift the value a little around its base.
const tiles: { label: string; value: number; digits: number; unit: string; tone: Tone; lines: string[]; tick?: number }[] = [
  {
    label: 'OEE', value: 82.4, digits: 1, unit: '%', tone: 'ok', tick: 0.4,
    lines: en ? ['before 47.2 %'] : ['vorher 47,2 %'],
  },
  {
    label: en ? 'Actual cycle' : 'Ist-Takt', value: 19.3, digits: 1, unit: 's', tone: 'ok', tick: 0.3,
    lines: en ? ['before 39.8 s'] : ['vorher 39,8 s'],
  },
  {
    label: en ? 'Scrap' : 'Ausschuss', value: 2.1, digits: 1, unit: '%', tone: 'warn',
    lines: en ? ['target 2.0 %'] : ['Ziel 2,0 %'],
  },
  {
    label: 'Reporting', value: 2, digits: 0, unit: en ? 'h/wk' : 'h/Wo', tone: 'ok',
    lines: en ? ['before 8 h/wk'] : ['vorher 8 h/Wo'],
  },
];

// OEE per week, oldest first; same story as before (47 % → 82 %).
const oee = [47, 49, 48, 53, 57, 62, 68, 73, 77, 79, 81, 82];
const TARGET = 80;
const MAX = 100;

// Event pool; the first four are rendered, the script keeps adding from the pool.
const events: { tone: Tone; text: string }[] = en
  ? [
      { tone: 'warn', text: 'Short stop · Station 3' },
      { tone: 'ok', text: 'Shift handover logged' },
      { tone: 'ok', text: 'Changeover done · Line 2' },
      { tone: 'bad', text: 'Fault · Press 4 · 3 min' },
      { tone: 'ok', text: 'Quality check passed' },
      { tone: 'warn', text: 'Material resupply requested' },
      { tone: 'ok', text: 'OEE shift B +4 pp' },
    ]
  : [
      { tone: 'warn', text: 'Kurzstopp · Station 3' },
      { tone: 'ok', text: 'Schichtübergabe erfasst' },
      { tone: 'ok', text: 'Rüsten beendet · Linie 2' },
      { tone: 'bad', text: 'Störung · Presse 4 · 3 min' },
      { tone: 'ok', text: 'Qualitätsprüfung bestanden' },
      { tone: 'warn', text: 'Material angefordert' },
      { tone: 'ok', text: 'OEE Schicht B +4 PP' },
    ];

// Build-time clock; the script replaces it with the visitor's time.
const now = new Date();
const hhmm = (d: Date) => `${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`;
const initialEvents = events.slice(0, 4).map((e, i) => ({ ...e, time: hhmm(new Date(now.getTime() - (i * 17 + 3) * 60000)) }));

// ISO calendar week for the chart axis.
function isoWeek(d: Date) {
  const t = new Date(Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()));
  t.setUTCDate(t.getUTCDate() + 4 - (t.getUTCDay() || 7));
  return Math.ceil(((t.getTime() - Date.UTC(t.getUTCFullYear(), 0, 1)) / 86400000 + 1) / 7);
}
const kw = isoWeek(now);
const weekLabel = (offset: number) => String(((kw + offset - 1 + 52) % 52) + 1).padStart(2, '0');

// Lucide icons, as used on the TrakState board.
const ICON: Record<Tone, string> = {
  ok: '<circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/>',
  bad: '<circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/>',
  warn: '<path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"/><path d="M12 9v4"/><path d="M12 17h.01"/>',
};
---
<div class="cockpit-wrapper">
  <div
    class="cockpit-panel"
    data-cockpit
    data-locale={locale}
    data-week-label={L.week}
    data-events={JSON.stringify(events)}
  >
    <!-- Glass reflections of the ASIGHT frame -->
    <div class="glass-reflection-top"></div>
    <div class="glass-reflection-diagonal"></div>
    <div class="ambient-glow-tr"></div>
    <div class="ambient-glow-bl"></div>

    <!-- Logo Watermark -->
    <img
      src="/assets/logos/asight-logo.svg"
      alt=""
      aria-hidden="true"
      class="cockpit-watermark"
    />

    <div class="ts-screen">
      <p class="ts-title">
        <span class="ts-title-name"><TrakStateWordmark size={22} /><span>{L.board}<span class="ts-site"> · {L.site}</span></span></span>
        <span class="ts-chip" data-tone="ok">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICON.ok} />
          {L.state}
        </span>
      </p>

      <div class="ts-tiles">
        {tiles.map((t) => (
          <div class="ts-tile" data-tone={t.tone}>
            <p class="ts-k">{t.label}</p>
            <p class="ts-v">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICON[t.tone]} />
              <span data-tick={t.tick ? t.value : undefined} data-tick-range={t.tick} data-digits={t.digits}>{num(t.value, t.digits)}</span>
              <small>{t.unit}</small>
            </p>
            {t.lines.map((l) => <p class="ts-tg">{l}</p>)}
            <p class="ts-asof">{L.asOf} <span data-clock>{hhmm(now)}:00</span></p>
          </div>
        ))}
      </div>

      <div class="ts-panels">
        <div class="ts-panel">
          <h3>
            <span>{L.chart}</span>
            <span class="ts-legend"><i></i>{L.target}</span>
          </h3>
          <div class="ts-chart" role="img" aria-label={`${L.chart}: 47 % → 82 %`}>
            {oee.map((v, i) => (
              <span class="ts-bar" data-last={i === oee.length - 1 ? '1' : undefined} style={`height:${(v / MAX) * 100}%`}></span>
            ))}
            <span class="ts-target" style={`bottom:${(TARGET / MAX) * 100}%`}></span>
          </div>
          <div class="ts-axis">
            <span data-week-offset="-11">{L.week} {weekLabel(-11)}</span>
            <span data-week-offset="0">{L.week} {weekLabel(0)}</span>
          </div>
        </div>
        <div class="ts-panel">
          <h3><span>{L.events}</span></h3>
          <ol class="ts-events" data-event-list aria-hidden="true">
            {initialEvents.map((e) => (
              <li data-tone={e.tone}><span class="ts-time">{e.time}</span><i></i><span>{e.text}</span></li>
            ))}
          </ol>
        </div>
      </div>
    </div>

    {trakstate && (
      <a class="ts-cta" href={trakstate.url} target="_blank" rel="noopener" data-ts-click="hero_cockpit">
        <span class="ts-cta-text">
          <span class="ts-eyebrow"><span class="ts-eyebrow-dot" aria-hidden="true"></span>{L.eyebrow}</span>
          <span>{trakstate.strip_text}</span>
        </span>
        <span class="ts-cta-btn">{trakstate.strip_cta} <span aria-hidden="true">&rarr;</span></span>
      </a>
    )}
  </div>

  <!-- Floating shadow -->
  <div class="cockpit-shadow"></div>
</div>

<script>
  // Board "live" feel: visitor's clock and calendar week, two KPIs drifting a
  // little, and a new event every few seconds. Runs only while the board is on
  // screen, and the motion parts not at all with reduced motion.
  const panel = document.querySelector<HTMLElement>('[data-cockpit]');
  if (panel) {
    const en = panel.dataset.locale === 'en';
    const num = (n: number, digits: number) => (en ? n.toFixed(digits) : n.toFixed(digits).replace('.', ','));
    const two = (n: number) => String(n).padStart(2, '0');
    const clocks = [...panel.querySelectorAll<HTMLElement>('[data-clock]')];
    const setClock = () => {
      const d = new Date();
      const text = `${two(d.getHours())}:${two(d.getMinutes())}:${two(d.getSeconds())}`;
      clocks.forEach((el) => (el.textContent = text));
    };
    setClock();

    const now = new Date();
    const t = new Date(Date.UTC(now.getFullYear(), now.getMonth(), now.getDate()));
    t.setUTCDate(t.getUTCDate() + 4 - (t.getUTCDay() || 7));
    const kw = Math.ceil(((t.getTime() - Date.UTC(t.getUTCFullYear(), 0, 1)) / 86400000 + 1) / 7);
    panel.querySelectorAll<HTMLElement>('[data-week-offset]').forEach((el) => {
      const w = ((kw + Number(el.dataset.weekOffset) - 1 + 52) % 52) + 1;
      el.textContent = `${panel.dataset.weekLabel} ${two(w)}`;
    });

    // Rendered times come from the build; restamp them relative to now.
    const list = panel.querySelector<HTMLOListElement>('[data-event-list]');
    list?.querySelectorAll<HTMLElement>('.ts-time').forEach((el, i) => {
      const d = new Date(Date.now() - (i * 17 + 3) * 60000);
      el.textContent = `${two(d.getHours())}:${two(d.getMinutes())}`;
    });

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let pool: { tone: string; text: string }[] = [];
    try {
      pool = JSON.parse(panel.dataset.events ?? '[]');
    } catch {
      // The pool is rendered by the component itself; without it the list just stays as it is.
      pool = [];
    }
    const ticks = [...panel.querySelectorAll<HTMLElement>('[data-tick]')];

    let n = 0;
    let next = 4;
    let timer: number | undefined;
    const step = () => {
      n += 1;
      setClock();
      if (reduced) return;
      if (n % 2 === 0) {
        for (const el of ticks) {
          const base = Number(el.dataset.tick);
          const range = Number(el.dataset.tickRange);
          el.textContent = num(base + (Math.random() * 2 - 1) * range, Number(el.dataset.digits));
        }
      }
      if (list && pool.length && n % 4 === 0) {
        const e = pool[next % pool.length];
        next += 1;
        const d = new Date();
        const li = document.createElement('li');
        li.dataset.tone = e.tone;
        li.className = 'ts-new';
        const time = document.createElement('span');
        time.className = 'ts-time';
        time.textContent = `${two(d.getHours())}:${two(d.getMinutes())}`;
        const text = document.createElement('span');
        text.textContent = e.text;
        li.append(time, document.createElement('i'), text);
        list.prepend(li);
        while (list.children.length > 4) list.lastElementChild?.remove();
      }
    };

    new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting && timer === undefined) {
        timer = window.setInterval(step, 1000);
      } else if (!entry.isIntersecting && timer !== undefined) {
        window.clearInterval(timer);
        timer = undefined;
      }
    }).observe(panel);
  }
</script>

<style>
  /* ---------- ASIGHT frame ---------- */
  .cockpit-wrapper {
    perspective: 1200px;
    width: 100%;
    max-width: 720px;
  }

  .cockpit-panel {
    /* TrakState tokens (copied from the TrakState website, globals.css) */
    --ts-bg: #0e1116;
    /* Glass surfaces instead of TrakState's solid cards, so the ASIGHT
       frame and watermark show through. */
    --ts-card: rgba(255,255,255,0.04);
    --ts-card-border: rgba(255,255,255,0.08);
    --ts-border: rgba(255,255,255,0.10);
    --ts-fg: #e7edf3;
    --ts-muted: #8a98aa;
    --ts-brand: #45b2c6;
    --ts-ok: #37b278;
    --ts-warn: #e0a82a;
    --ts-bad: #e0605a;
    --ts-mono: "IBM Plex Mono", ui-monospace, monospace;
    --ts-sans: "Archivo", "Inter", system-ui, sans-serif;

    background: linear-gradient(145deg, rgba(255,255,255,0.05) 0%, rgba(255,255,255,0.015) 100%);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 22px;
    padding: 16px 16px 14px;
    position: relative;
    overflow: hidden;
    box-shadow: 0 25px 60px rgba(0,0,0,0.5), 0 10px 30px rgba(0,0,0,0.3), inset 0 1px 0 rgba(255,255,255,0.07);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    transform: rotateX(2deg) rotateY(-30deg);
    transform-style: preserve-3d;
    animation: panelFadeIn 1s cubic-bezier(0.16,1,0.3,1) forwards;
    opacity: 0;
  }

  @keyframes panelFadeIn {
    from {
      opacity: 0;
      transform: rotateX(4deg) rotateY(-35deg) scale(0.95) translateY(30px);
    }
    to {
      opacity: 1;
      transform: rotateX(2deg) rotateY(-30deg) scale(1) translateY(0);
    }
  }

  .glass-reflection-top {
    position: absolute;
    top: 0;
    left: 10%;
    right: 10%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.15), transparent);
    pointer-events: none;
  }

  .ambient-glow-tr {
    position: absolute;
    top: -60px;
    right: -60px;
    width: 200px;
    height: 200px;
    background: radial-gradient(circle, rgba(69,178,198,0.10) 0%, transparent 70%);
    pointer-events: none;
  }

  .glass-reflection-diagonal {
    position: absolute;
    top: -50px;
    left: -50px;
    width: 60%;
    height: 120%;
    background: linear-gradient(125deg, rgba(255,255,255,0.03) 0%, transparent 40%);
    pointer-events: none;
    transform: skewX(-15deg);
  }

  .ambient-glow-bl {
    position: absolute;
    bottom: -40px;
    left: -40px;
    width: 160px;
    height: 160px;
    background: radial-gradient(circle, rgba(57,172,115,0.05) 0%, transparent 70%);
    pointer-events: none;
  }

  .cockpit-watermark {
    position: absolute;
    top: 50%;
    left: 55%;
    transform: translate(-50%, -50%);
    width: 90%;
    height: auto;
    opacity: 0.085;
    pointer-events: none;
    z-index: 0;
    user-select: none;
  }

  .cockpit-shadow {
    width: 85%;
    height: 20px;
    margin: -8px auto 0;
    background: radial-gradient(ellipse, rgba(175,221,233,0.08) 0%, transparent 70%);
    filter: blur(12px);
  }

  /* ---------- TrakState board ---------- */
  .ts-eyebrow {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 3px;
    font-family: var(--ts-mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ts-brand);
  }

  .ts-eyebrow-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ts-brand);
    box-shadow: 0 0 8px rgba(69,178,198,0.7);
  }

  .ts-screen {
    position: relative;
    display: grid;
    gap: 10px;
    z-index: 1;
    color: var(--ts-fg);
    font-family: var(--ts-sans);
    text-align: left;
  }

  .ts-screen > * {
    min-width: 0;
  }

  .ts-screen p,
  .ts-screen h3,
  .ts-screen ol {
    margin: 0;
  }

  .ts-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 9px 12px;
    background: var(--ts-card);
    border: 1px solid var(--ts-card-border);
    border-radius: 12px;
    font-size: 14px;
    font-weight: 700;
  }

  .ts-title-name {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }

  .ts-title-name svg {
    flex-shrink: 0;
  }

  .ts-title-name span {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .ts-chip {
    --tone: var(--ts-ok);
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 2px 8px;
    border: 1px solid color-mix(in srgb, var(--tone) 55%, transparent);
    background: color-mix(in srgb, var(--tone) 10%, transparent);
    border-radius: 20px;
    color: var(--tone);
    font-size: 11px;
    font-weight: 600;
    white-space: nowrap;
  }

  .ts-tiles {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
  }

  .ts-tile {
    --tone: var(--ts-muted);
    display: flex;
    flex-direction: column;
    padding: 11px 10px 9px;
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--ts-card-border);
    border-radius: 12px;
    box-shadow: inset 0 3px 0 var(--tone);
    background: linear-gradient(color-mix(in srgb, var(--tone) 8%, transparent), color-mix(in srgb, var(--tone) 8%, transparent)), var(--ts-card);
  }

  .ts-tile[data-tone='ok'],
  .ts-events :global(li[data-tone='ok']) { --tone: var(--ts-ok); }
  .ts-tile[data-tone='warn'],
  .ts-events :global(li[data-tone='warn']) { --tone: var(--ts-warn); }
  .ts-tile[data-tone='bad'],
  .ts-events :global(li[data-tone='bad']) { --tone: var(--ts-bad); }

  .ts-k {
    font-size: 11px;
    color: var(--ts-muted);
  }

  .ts-v {
    display: flex;
    align-items: center;
    gap: 5px;
    margin-top: 4px !important;
    font-family: var(--ts-mono);
    font-size: 21px;
    font-weight: 600;
    line-height: 1.15;
    white-space: nowrap;
    color: var(--tone);
  }

  .ts-v svg {
    flex: none;
  }

  .ts-v small {
    align-self: flex-end;
    padding-bottom: 2px;
    font-size: 11px;
    font-weight: 500;
  }

  .ts-tg {
    margin-top: 3px !important;
    font-family: var(--ts-mono);
    font-size: 10px;
    color: var(--ts-muted);
    white-space: nowrap;
  }

  .ts-tg + .ts-tg {
    margin-top: 0 !important;
  }

  .ts-asof {
    margin-top: auto !important;
    padding-top: 6px;
    font-family: var(--ts-mono);
    font-size: 9px;
    color: var(--ts-muted);
  }

  .ts-panels {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 8px;
  }

  .ts-panel {
    padding: 9px 10px 10px;
    border: 1px solid var(--ts-card-border);
    border-radius: 12px;
    background: var(--ts-card);
  }

  .ts-panel h3 {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 4px 10px;
    font-family: var(--ts-sans);
    font-size: 11px;
    font-weight: 400;
    color: var(--ts-muted);
  }

  .ts-legend {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: var(--ts-mono);
    font-size: 9px;
  }

  .ts-legend i {
    width: 12px;
    border-top: 1px dashed rgba(231,237,243,0.6);
  }

  .ts-chart {
    position: relative;
    display: flex;
    align-items: flex-end;
    gap: 3px;
    height: 52px;
    margin-top: 8px;
    border-bottom: 1px solid var(--ts-border);
  }

  .ts-bar {
    flex: 1;
    min-width: 3px;
    background: rgba(138,152,170,0.4);
  }

  .ts-bar[data-last='1'] {
    background: var(--ts-brand);
  }

  .ts-target {
    position: absolute;
    left: 0;
    right: 0;
    border-top: 1px dashed rgba(231,237,243,0.6);
  }

  .ts-axis {
    display: flex;
    justify-content: space-between;
    margin-top: 4px;
    font-family: var(--ts-mono);
    font-size: 9px;
    color: var(--ts-muted);
  }

  .ts-events {
    display: grid;
    gap: 4px;
    margin-top: 8px !important;
    padding: 0;
    list-style: none;
    overflow: hidden;
  }

  .ts-events :global(li) {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 10.5px;
    color: var(--ts-fg);
    white-space: nowrap;
  }

  .ts-events :global(li > span:last-child) {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .ts-events :global(li i) {
    flex: none;
    width: 7px;
    height: 7px;
    background: var(--tone);
  }

  .ts-events :global(.ts-time),
  .ts-time {
    flex: none;
    font-family: var(--ts-mono);
    font-size: 9.5px;
    color: var(--ts-muted);
  }

  .ts-events :global(li.ts-new) {
    animation: tsEventIn 0.5s ease;
  }

  @keyframes tsEventIn {
    from { opacity: 0; transform: translateY(-6px); background: color-mix(in srgb, var(--tone) 18%, transparent); }
    to { opacity: 1; transform: none; background: transparent; }
  }

  /* CTA: square teal button as on trakstate.com */
  .ts-cta {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 10px;
    padding: 4px 4px 4px 8px;
    text-decoration: none;
